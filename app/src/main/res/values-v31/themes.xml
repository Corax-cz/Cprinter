<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ 的启动画面。

    不声明这几个属性时，系统会自己拿 launcher 图标放大展示（152px 的位图铺在
    屏幕正中），既是巨大的一坨又是糊的。这里换成固定 84dp 的矢量小 logo，
    底色跟随深浅色模式（values-night 覆盖 splash_bg）。
-->
<resources>
    <style name="Theme.Cprinter" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_bg</item>
        <item name="android:windowSplashScreenBackground">@color/splash_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
</resources>
